# Configuración del Servidor
NODE_ENV=development
PORT=5000
HOST=localhost

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=telemetria_user
DB_PASSWORD=telemetria_password_123
DB_NAME=telemetria_san_javier
DB_POOL_MIN=2
DB_POOL_MAX=10

# InfluxDB 2.x
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influx-token-here
INFLUX_ORG=CEA_Project_SPA
INFLUX_BUCKET=sta_sb_telemetria

# MQTT Broker
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=telemetria_user
MQTT_PASSWORD=mqtt_password_123
MQTT_CLIENT_ID=sta-sb-backend

# JWT Autenticación
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Seguridad
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# WebSocket
WS_PORT=5001

# Simulador
SIMULATOR_STATIONS=30
SIMULATOR_INTERVAL=5000
